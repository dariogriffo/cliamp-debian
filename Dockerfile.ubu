ARG UBUNTU_DIST=noble
FROM ubuntu:$UBUNTU_DIST

ARG UBUNTU_DIST
ARG cliamp_VERSION
ARG BUILD_VERSION
ARG FULL_VERSION
ARG ARCH

RUN mkdir -p /output/usr/bin
RUN mkdir -p /output/usr/share/doc/cliamp
RUN mkdir -p /output/usr/share/man/man1
RUN mkdir -p /output/usr/share/applications
RUN mkdir -p /output/usr/share/icons/hicolor/512x512/apps
RUN mkdir -p /output/usr/share/pixmaps
RUN mkdir -p /output/usr/share/bash-completion/completions
RUN mkdir -p /output/usr/share/zsh/vendor-completions
RUN mkdir -p /output/DEBIAN

# Upstream publishes bare binaries named cliamp-linux-<goarch>; build_*.sh
# stages the one for this architecture as dist/$ARCH/cliamp.
COPY dist/${ARCH}/cliamp /output/usr/bin/cliamp
COPY debian/cliamp.1 /output/usr/share/man/man1/cliamp.1
# The desktop entry and the icon come from the upstream tag, staged by
# build_*.sh under assets/.
COPY assets/cliamp.desktop /output/usr/share/applications/cliamp.desktop
COPY assets/cliamp.png /output/usr/share/icons/hicolor/512x512/apps/cliamp.png
# Completions are generated by build_*.sh from the amd64 binary (the scripts
# are plain shell templates and identical on every architecture). Fish is
# skipped: upstream's CLI library renders a broken fish template.
COPY completions/cliamp.bash /output/usr/share/bash-completion/completions/cliamp
COPY completions/_cliamp /output/usr/share/zsh/vendor-completions/_cliamp
RUN chmod 755 /output/usr/bin/cliamp
RUN ln -sf ../icons/hicolor/512x512/apps/cliamp.png /output/usr/share/pixmaps/cliamp.png
RUN gzip -9n /output/usr/share/man/man1/*.1
COPY output/DEBIAN/control /output/DEBIAN/
COPY output/DEBIAN/postinst /output/DEBIAN/postinst
RUN chmod 755 /output/DEBIAN/postinst
# The same DEP-5 copyright file the source package ships.
COPY debian/copyright /output/usr/share/doc/cliamp/copyright
COPY output/changelog.Debian /output/usr/share/doc/cliamp/
COPY output/README.md /output/usr/share/doc/cliamp/

# Normalise permissions: the files copied from the build host may carry group
# write bits, which dpkg-deb would preserve and lintian would flag.
RUN find /output/usr -type d -exec chmod 755 {} + \
 && find /output/usr -type f -exec chmod 644 {} + \
 && chmod 755 /output/usr/bin/cliamp

RUN sed -i "s/DIST/$UBUNTU_DIST/" /output/usr/share/doc/cliamp/changelog.Debian
# FULL_VERSION carries the architecture suffix used for the .deb filename;
# the changelog must show the package version instead.
RUN sed -i "s/FULL_VERSION/${cliamp_VERSION}-${BUILD_VERSION}~${UBUNTU_DIST}/" /output/usr/share/doc/cliamp/changelog.Debian
RUN gzip -9n /output/usr/share/doc/cliamp/changelog.Debian
RUN sed -i "s/DIST/$UBUNTU_DIST/" /output/DEBIAN/control
RUN sed -i "s/cliamp_VERSION/$cliamp_VERSION/" /output/DEBIAN/control
RUN sed -i "s/BUILD_VERSION/$BUILD_VERSION/" /output/DEBIAN/control
RUN sed -i "s/SUPPORTED_ARCHITECTURES/$ARCH/" /output/DEBIAN/control

RUN dpkg-deb --build /output /cliamp_${FULL_VERSION}.deb
